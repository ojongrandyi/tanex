PORT=5000

# Generate both of these fresh for a real deployment — never reuse the sample values below.
#
# To set/change the admin password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR-NEW-PASSWORD', 12))"
# then paste the output as ADMIN_PASSWORD_HASH.
#
# To generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-see-instructions-above
# If SESSION_SECRET is unset the server generates a random one once and keeps it in
# .session-secret next to the database (never a value from the code). Setting it is still preferred.
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# No longer read by the app: it ships no demo data. Keep it "false" (or unset).
SEED_DEMO_DATA=false

# CRITICAL on a real deployment: if your host wipes files that aren't tracked by git on every
# deploy (some do, as part of a clean checkout), the database silently disappears the moment
# you push new code — since it MUST be gitignored (a live database can't be committed).
# On Hostinger, create /home/<user>/tanex-data/ OUTSIDE the app folder and point DB_PATH at a
# .db file inside it (DEPLOYMENT.md §4). Leave unset for local dev (data/tanex.db is used).
# DB_PATH=/home/<user>/tanex-data/tanex.db

# Uploaded package photos, payment-proof screenshots, blog images and staff photos (images/, proofs/, blog/ and avatars/ are created inside
# on start). Same rule as DB_PATH: on a real deployment point this at a persistent folder OUTSIDE
# the app/deploy directory, and include it in backups. When unset it defaults to an "uploads"
# folder next to the database (data/uploads locally).
# UPLOADS_DIR=/home/<user>/tanex-data/uploads

# First Super Admin (IAM_RBAC_SPEC §8). Read on start only while no staff account exists:
# creates SUPER_ADMIN_EMAIL with ADMIN_PASSWORD_HASH as a temporary password (name defaults to
# "Super Admin"). Otherwise run `npm run create-super-admin`. ADMIN_PASSWORD_HASH is still the
# console password until task B.2 switches login to staff accounts; remove it after that.
# SUPER_ADMIN_EMAIL=<owner's email>
# SUPER_ADMIN_NAME=<owner's name>

# Email via Hostinger Email (NOTIFICATIONS_SPEC §3). Without SMTP_HOST email is off: nothing is
# queued and "Forgot password?" is hidden. Settings → Email in the console sends a test.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@tanexsarl.com
# SMTP_PASS=<mailbox password>
# MAIL_FROM="TanEx <info@tanexsarl.com>"
# MAIL_STAFF_ALERTS_TO=info@tanexsarl.com
# MAIL_REPLY_TO=info@tanexsarl.com
# Base of the links in emails (reset link, quote page). Defaults to https://tanexsarl.com; set it
# for local testing (http://localhost:5000) or a staging copy. Never taken from the request.
# APP_URL=https://tanexsarl.com

# Extra browser origins allowed to call the API with credentials (comma-separated). The site
# itself, www, APP_URL and localhost are always allowed; leave unset unless another origin needs it.
# CORS_ORIGINS=
