{
  "name": "tanex",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"blue,green\" \"npm run server\" \"vite\"",
    "dev:vite": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "postinstall": "npm run build",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "test": "node --import tsx --test scripts/*.test.ts",
    "create-super-admin": "node dist-server/scripts/create-super-admin.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^3.0.7",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.475.0",
    "nodemailer": "10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "gltfpack": "^1.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12"
  }
}
